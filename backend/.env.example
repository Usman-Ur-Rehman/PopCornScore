# Copy this file to .env and fill in your values

# SQL Server connection
# For default local instance: DB_SERVER=localhost
# For named instance (e.g. SQL Express): DB_SERVER=localhost\SQLEXPRESS
DB_SERVER=localhost
DB_NAME=PopcornScoreDB
DB_USER=sa
DB_PASSWORD=your_sa_password_here

# JWT secret (change to a long random string in production)
JWT_SECRET=popcornscore_super_secret_jwt_key_2026

# Server port
PORT=5000
